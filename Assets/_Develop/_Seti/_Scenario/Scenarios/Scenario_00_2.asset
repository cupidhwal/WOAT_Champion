  m_Script: {fileID: 11500000, guid: 33ceabea7554cb246a85b045d3f85284, type: 3}
  m_Name: Scenario_00_2
  m_EditorClassIdentifier: 
  id: 2
  title: "\uC138 \uBC88\uC9F8 \uD50C\uB9B0\uB290"
  dialogues:
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uCC3E\uC558\uC5B4. \uD589\uBC29\uBD88\uBA85
      \uB410\uB2E4\uB358 \uC0AC\uB78C \uB9D0\uC774\uC57C."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "......\uC8FD\uC5C8\uC5B4?"
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uADF8\uB798."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uADF8\uB798\uB3C4 \uD50C\uB9B0\uB290\uB294 \uC8FC\uBBFC\uB4E4\uC5D0
      \uB300\uD55C \uC560\uCC29\uC774 \uC788\uB358 \uBAA8\uC591\uC778\uC9C0, \uC9C4\uC2E4\uD55C
      \uD0DC\uB3C4\uB85C \uC2ED\uC790\uAC00\uB97C \uADF8\uB9AC\uBA70 \uACE0\uC778\uC758
      \uBA85\uBCF5\uC744 \uBE4C\uC5C8\uB2E4."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uB098\uB294 \uC7A0\uC2DC \uADF8\uB140\uB97C \uAE30\uB2E4\uB9B0 \uB4A4
      \uC774 \uC0AC\uAC74\uC5D0 \uB300\uD55C \uB0B4 \uC0DD\uAC01\uC744 \uBC1D\uD614\uB2E4.
      \uADF8\uB140\uC758 \uB0AF\uBE5B\uC774 \uD558\uC597\uAC8C \uC9C8\uB824\uAC14\uB2E4."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uADF8\uB798....... \uB610 \uADF8\uB7AC\uB2E8 \uAC70\uC9C0......."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uB610?"
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uADF8\uAC8C \uC0AC\uC2E4\uC740, \uB610 \uD589\uBC29\uBD88\uBA85\uC790\uAC00
      \uB098\uC654\uB294\uB370....... \uADF8 \uC0AC\uB78C\uC740 \uBC14\uB85C \uBC1C\uACAC\uB410\uC5B4."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uC774\uBBF8 \uC8FD\uC740 \uC0C1\uD0DC\uC600\uB2E4\uB294 \uB9D0\uC774\uAD6C\uB098."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uC751. \uC608\uC804\uC5D0\uB294 \uC774\uB7F0 \uC77C\uC774 \uD55C
      \uBC88\uB3C4 \uC5C6\uC5C8\uB294\uB370. \uBB54\uAC00 \uC0AC\uAC74\uC774 \uBC8C\uC5B4\uC9C0\uACE0
      \uC788\uB294 \uAC83 \uAC19\uC544."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uC788\uC796\uC544, \uB108\uB9CC \uAD1C\uCC2E\uB2E4\uBA74 \uADF8 \uC0B4\uC778\uB9C8\uB97C
      \uC7A1\uC544\uC8FC\uC9C0 \uC54A\uC744\uB798?"
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uB9C8\uACBD\uC740 \uC774\uBBF8 \uC545\uADC0\uB4E4\uB85C\uB3C4 \uCDA9\uBD84\uD788
      \uC704\uD5D8\uD55C\uB370, \uC8FC\uBBFC\uB4E4\uC744 \uC704\uD611\uD558\uB294
      \uC0B4\uC778\uB9C8\uAE4C\uC9C0 \uB3CC\uC544\uB2E4\uB2C8\uB294 \uAC78 \uBCF4\uACE0\uB9CC
      \uC788\uC744 \uC218\uB294 \uC5C6\uC5B4."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uADF8\uB7F0 \uAC70\uB77C\uBA74 \uC5BC\uB9C8\uB4E0\uC9C0. \uB098\uB3C4
      \uB354 \uAE4A\uC740 \uACF3\uC73C\uB85C \uB4E4\uC5B4\uAC00\uB824\uBA74 \uADF8\uB188\uC744
      \uC8FD\uC5EC\uC57C \uD560 \uD14C\uB2C8\uAE4C."
    nextType: 0
