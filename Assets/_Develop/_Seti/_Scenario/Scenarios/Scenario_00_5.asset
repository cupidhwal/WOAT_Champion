  m_Script: {fileID: 11500000, guid: 33ceabea7554cb246a85b045d3f85284, type: 3}
  m_Name: Scenario_00_5
  m_EditorClassIdentifier: 
  id: 5
  title: "\uB9C8\uC9C0\uB9C9 \uD50C\uB9B0\uB290"
  dialogues:
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uD50C\uB9B0\uB290......?"
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uD50C\uB9B0\uB290\uC758 \uC2DC\uCCB4. \uD1A0\uB9C9\uB09C \uADF8\uB140\uC758
      \uD314. \uADF8\uAC83\uC744 \uC950\uACE0 \uC788\uB294 \uB0B4 \uC190. \uC785
      \uC548\uC758 \uBD80\uB4DC\uB7EC\uC6B4 \uC774\uBB3C\uAC10. \uADF8\uB9AC\uACE0......
      \uC2DD\uB3C4\uB97C \uD0C0\uACE0 \uD750\uB974\uB294 \uB2EC\uCF64\uD55C \uC561\uCCB4."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uC6B1, \uC6B0\uC6E9."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uBB34\uC758\uC2DD\uC801\uC73C\uB85C, \uC5B4\uB834\uD48B\uC774 \uC9D0\uC791\uD588\uB358
      \uC0AC\uC2E4. \uADF8\uB7F4 \uB9AC\uAC00 \uC5C6\uB2E4\uBA70 \uC678\uBA74\uD574\uC654\uB358
      \uD604\uC2E4. \uADF8\uB7EC\uB098 \uBE44\uB85C\uC18C \uAE68\uB2EB\uB294 \uB9C8\uACBD\uC758
      \uC9C4\uC2E4."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uD1A0\uB9C9\uB09C \uD50C\uB9B0\uB290\uC758 \uD314\uC5D0\uB294 \uC0B4\uC810\uC744
      \uD06C\uAC8C \uD55C \uC785 \uBCA0\uC5B4 \uBB38 \uD754\uC801\uC774 \uC801\uB098\uB77C\uD588\uACE0,
      \uADF8 \uC0B4\uC810\uC740 \uC774\uBB3C\uC744 \uBC49\uC740 \uB0B4 \uC785\uC5D0\uC11C
      \uB098\uC654\uB2E4."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uBCC0\uBA85\uC758 \uC5EC\uC9C0\uAC00 \uC5C6\uB2E4."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uC544, \uC544\uC544\uC544....... \uC544\uC544\uC544\uC544\uC544\uC544\uC544\uC544\uC544\uC544\uC544\uC544\uC544\uC544......."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uC0B4\uC778\uB9C8\uB294 \uB098\uC600\uB2E4."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uADF8\uB85C\uBD80\uD130 \uC5BC\uB9C8\uB098 \uC9C0\uB0AC\uC744\uAE4C."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uB098\uB294 \uC790\uD3EC\uC790\uAE30\uD588\uC5C8\uB2E4. \uC218\uCC28\uB840
      \uC790\uC0B4\uC744 \uC2DC\uB3C4\uD588\uACE0, \uC6D0\uD749\uC744 \uBC84\uB824\uB3C4
      \uBCF4\uC558\uB2E4."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uBD80\uC9C8\uC5C6\uC5C8\uB2E4. \uB2C8\uD2B8\uD558\uBCA4\uC5D0\uC11C\uB3C4
      \uB098\uB294 \uBD80\uD65C\uD560 \uC218 \uC788\uC5C8\uACE0, \uD50C\uB9B0\uB290\uC758
      \uC2DC\uCCB4\uB9CC \uC810\uC810 \uB354 \uACB0\uC190\uB420 \uBFD0\uC774\uC5C8\uB2E4."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uC6D0\uD749\uB3C4 \uBB38\uB4DD \uB3CC\uC544\uBCF4\uBA74 \uBC18\uB4DC\uC2DC
      \uB0B4 \uC190 \uC548\uC5D0 \uB3CC\uC544\uC640 \uC788\uC5C8\uB2E4."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uADF8\uB9AC\uACE0 \uBAB8\uC5D0\uB294 \uB9C8\uACBD\uC774 \uAC15\uC694\uD558\uB4EF
      \uC0C1\uAE30\uC2DC\uD0A4\uB294 \uACF5\uBCF5\uAC10\uC774 \uB0A8\uC558\uB2E4."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uADF8\uB798\uC11C \uB098\uB294, \uB354 \uB2A6\uAE30 \uC804\uC5D0
      \uD50C\uB9B0\uB290\uB97C \uBB3B\uC5B4\uC8FC\uC5C8\uB2E4."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uC774\uBBF8 \uBC97\uC5B4\uB0A0 \uC218 \uC5C6\uAC8C \uB41C \uAC70\uAD6C\uB098."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uADF8\uB807\uB2E4\uBA74 \uB2F5\uC740 \uD558\uB098\uBFD0\uC774\uC9C0.
      \uADF8\uB807\uC9C0, \uD50C\uB9B0\uB290?"
    nextType: 0
