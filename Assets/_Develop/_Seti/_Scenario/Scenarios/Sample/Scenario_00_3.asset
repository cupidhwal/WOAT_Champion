  m_Script: {fileID: 11500000, guid: 33ceabea7554cb246a85b045d3f85284, type: 3}
  m_Name: Scenario_00_3
  m_EditorClassIdentifier: 
  id: 3
  title: "\uB124 \uBC88\uC9F8 \uD50C\uB9B0\uB290"
  dialogues:
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "......\uC5B4\uB5BB\uAC8C \uB410\uC5B4?"
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uB188\uC774 \uB0A8\uAE34 \uD754\uC801 \uAC19\uC740 \uAC78 \uD558\uB098
      \uB354 \uBC1C\uACAC\uD588\uC5B4. \uD53C\uAC00 \uD280\uC5B4 \uC788\uC5C8\uB294\uB370......
      \uADF8 \uD754\uC801\uC744 \uC9C0\uC6B0\uB824\uB358 \uBAA8\uC591\uC774\uC57C."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uB098\uB294 \uD50C\uB9B0\uB290\uC5D0\uAC8C \uC6D0\uD749\uC774 \uBCF4\uC5EC\uC900
      \uB450 \uBC88\uC9F8 \uAD11\uACBD\uC5D0 \uB300\uD574 \uC774\uC57C\uAE30\uD588\uB2E4.
      \uADF8\uB140\uB294 \uB0B4 \uC774\uC57C\uAE30\uB97C \uB4E4\uC73C\uBA70 \uBAB8\uC744
      \uB5A8\uC5C8\uB2E4."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uADF8 \uD53C\uB294 \uADF8\uB188 \uC790\uC2E0\uC758 \uD53C\uC77C \uAC70\uC57C.
      \uC0DD\uAC01\uD574 \uBD10."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uB10C \uADF8\uAC8C \uB204\uAD6C \uD53C\uC778\uC9C0\uAC00 \uC911\uC694\uD574?
      \uC5B4\uCA0C\uAC70\uB098 \uC0AC\uB9DD\uC790\uB294 \uACC4\uC18D \uB298\uACE0
      \uC788\uB2E8 \uB9D0\uC774\uC57C......."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "......\uB530\uC9C0\uACE0 \uBCF4\uBA74 \uADF8\uB140\uC758 \uB9D0\uC774
      \uB9DE\uB2E4. \uC9C0\uAE08 \uC911\uC694\uD55C \uAC74 \uB188\uC758 \uBC94\uD589\uC744
      \uBC1D\uD788\uB294 \uAC8C \uC544\uB2C8\uB77C, \uB188\uC744 \uCC98\uB2E8\uD558\uB294
      \uAC70\uB2C8\uAE4C."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uBBF8\uC548. \uB0B4\uAC00 \uC7A0\uAE50 \uC5B4\uB5BB\uAC8C \uB410\uB098\uBCF4\uB2E4."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uC788\uC796\uC544, \uB108 \uB9D0\uC774\uC57C. \uC774\uC81C \uB9C8\uACBD\uC5D0
      \uADF8\uB9CC \uB4E4\uC5B4\uAC00\uBA74 \uC548 \uB3FC?"
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uADF8\uB7F4 \uC218\uB294 \uC5C6\uC5B4. \uB09C \uC545\uADC0\uC758
      \uC2EC\uC7A5\uC744 \uAC00\uC838\uAC00\uC57C \uD55C\uB2E4\uB2C8\uAE4C. \uADF8\uAC83\uB3C4
      \uC624\uB798\uB3C4\uB85D \uC369\uC9C0 \uC54A\uB294 \uAC78\uB85C."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uB098, \uB098\uB294...... \uAC71\uC815\uB3FC\uC11C \uADF8\uB798.
      \uB124\uAC00, \uC55E\uC73C\uB85C\uB3C4 \uACC4\uC18D \uADF8\uB807\uAC8C \uBD80\uD65C\uD560
      \uC218 \uC788\uC744 \uAC70\uB77C\uB294 \uBCF4\uC7A5\uB3C4 \uC5C6\uC744 \uD150\uB370."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uB108\uC5D0\uAC8C\uB3C4 \uC18C\uC911\uD55C \uC0AC\uB78C\uC774 \uC788\uC744
      \uAC70 \uC544\uB2C8\uC57C? \uAC00\uC871\uC774\uB77C\uB4E0\uAC00. \uACE0\uD5A5\uC5D0\uB294
      \uB9D0\uC774\uC57C."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uAC00\uC871\uC774\uB77C....... \uC591\uC544\uBC84\uC9C0\uAC00 \uACC4\uC2DC\uAE34
      \uD558\uB294\uB370."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uAC70\uBD10. \uADF8\uB7EC\uB2C8\uAE4C \uC774\uC81C \uADF8\uB9CC \uD3EC\uAE30\uD558\uACE0.......
      \uB124\uAC00 \uB354 \uC774\uC0C1 \uB4E4\uC5B4\uAC00\uC9C0 \uC54A\uACA0\uB2E4\uBA74,
      \uB9C8\uACBD\uC73C\uB85C \uD1B5\uD558\uB294 \uBB38\uC740 \uB2EB\uC544\uBC84\uB9B4
      \uAC70\uC57C. \uC601\uC6D0\uD788."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uADF8\uB7EC\uBA74 \uC800 \uC548\uC5D0 \uC0B4\uC778\uB9C8\uAC00 \uC788\uB4E0
      \uB9D0\uB4E0...... \uB354 \uC774\uC0C1 \uB2C8\uD2B8\uD558\uBCA4\uACFC\uB294
      \uC0C1\uAD00 \uC5C6\uB294 \uC77C\uC774 \uB418\uACA0\uC9C0."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uD558....... \uD50C\uB9B0\uB290. \uADF8\uB807\uAC8C \uC548 \uBD24\uB294\uB370,
      \uC0DD\uAC01\uBCF4\uB2E4 \uC21C\uC9C4\uD558\uB124."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uB0B4\uAC00 \uC7AC\uBBF8\uC788\uB294 \uC0AC\uC2E4 \uD558\uB098 \uC54C\uB824\uC904\uAE4C?"
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uB2E4 \uC591\uC544\uBC84\uC9C0\uC57C. \uB9C8\uACBD\uC5D0\uC11C \uC545\uADC0\uC758
      \uC2EC\uC7A5\uC744 \uAC00\uC838\uC624\uB77C\uACE0 \uB0A0 \uC2DC\uD0A8 \uC0AC\uB78C\uB3C4,
      \uADF8\uB7F0 \uB098\uC5D0\uAC8C \uC6D0\uD749\uC744 \uC950\uC5B4\uC900 \uC0AC\uB78C\uB3C4......."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uADF8\uB9AC\uACE0 \uADF8 \uC0AC\uB78C\uC774 \uB0B4\uAC8C \uB9D0\uD588\uC9C0.
      \uBE48 \uC190\uC73C\uB85C \uB3CC\uC544\uC624\uBA74 \uB0B4 \uBAA9\uC228\uB3C4
      \uC5C6\uB2E4\uACE0."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uB0B4 \uC591\uC544\uBC84\uC9C0\uB294 \uC870\uAD6D\uC758 \uAD8C\uB825\uC790\uC774\uAE30
      \uB54C\uBB38\uC5D0, \uB09C \uC5B4\uB290 \uCABD\uC774\uB4E0 \uC8FD\uC5B4."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uC544\uB2C8\uC9C0....... \uCC28\uB77C\uB9AC \uB9C8\uACBD\uC744 \uD0D0\uC0AC\uD558\uB294
      \uD3B8\uC774 \uB0AB\uC9C0. \uC6B4 \uC88B\uAC8C \uC2EC\uC7A5\uC744 \uAD6C\uD574\uAC08
      \uC218 \uC788\uB2E4\uBA74 \uBAA9\uC228\uC740 \uBD80\uC9C0\uD560 \uC218 \uC788\uC744
      \uD14C\uB2C8\uAE4C."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uD50C\uB9B0\uB290\uB294 \uD558\uC597\uAC8C \uC9C8\uB9B0 \uC5BC\uAD74\uC774\uC5C8\uACE0,
      \uB354\uB294 \uB9D0\uC774 \uC5C6\uC5C8\uB2E4."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "......\uC54C\uC558\uC73C\uBA74 \uADF8\uB9CC \uBB38 \uC5F4\uC5B4."
    nextType: 0
