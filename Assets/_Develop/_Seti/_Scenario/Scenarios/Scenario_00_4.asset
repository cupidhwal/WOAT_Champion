  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33ceabea7554cb246a85b045d3f85284, type: 3}
  m_Name: Scenario_00_4
  m_EditorClassIdentifier: 
  id: 4
  title: "\uB2E4\uC12F \uBC88\uC9F8 \uD50C\uB9B0\uB290"
  dialogues:
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uC774\uC81C...... \uB098\uBC16\uC5D0 \uC548 \uB0A8\uC558\uC5B4."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: .......
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uC800\uAE38 \uBD10. \uB108\uB3C4 \uAE30\uC5B5\uD558\uACA0\uC9C0\uB9CC,
      \uC6D0\uB798 \uC800 \uC790\uB9AC\uC5D4 \uC0C1\uC778\uB4E4\uC774 \uC788\uC5C8\uC5B4.
      \uD558\uC9C0\uB9CC \uC774\uC820 \uADF8\uB9C8\uC800\uB3C4 \uC5C6\uC9C0.......
      \uB2E4 \uC8FD\uC740 \uAC70\uC57C."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: .......
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uB108\uBB34 \uBB34\uB364\uB364\uD55C \uAC70 \uC544\uB2C8\uC57C? \uACB0\uAD6D\uC5D4
      \uC678\uC9C0\uC778\uC774\uB2E4, \uC774\uAC70\uB2C8?"
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uB098\uC640 \uD50C\uB9B0\uB290 \uC0AC\uC774\uC5D0 \uC7A0\uC2DC \uCE68\uBB35\uC774
      \uC624\uAC04 \uB4A4, \uADF8\uB140\uAC00 \uB9D0\uD588\uB2E4."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uC788\uC796\uC544, \uAD1C\uCC2E\uB2E4\uBA74 \uB124 \uACE0\uD5A5 \uC598\uAE30\uB97C
      \uD574\uC904\uB798?"
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "......\uB4E4\uC5B4\uBD10\uC57C \uC88B\uC744 \uAC83 \uD558\uB098 \uC5C6\uC744
      \uD150\uB370."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uADF8\uB798\uB3C4 \uB4E3\uACE0 \uC2F6\uC5B4."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uB10C \uCC38 \uC774\uC0C1\uD55C \uC560\uC57C. \uB0B4 \uC774\uC57C\uAE30\uB97C
      \uAD81\uAE08\uD574\uD55C \uC0AC\uB78C\uC740 \uB2E8 \uD55C \uBA85\uB3C4 \uC5C6\uC5C8\uB294\uB370."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uC0AC\uC2E4, \uB09C \uB9C8\uACBD\uC5D0 \uCC98\uC74C \uC628 \uAC8C
      \uC544\uB2C8\uC57C. \uC5B4\uB838\uC744 \uB54C \uC544\uBC84\uC9C0...... \uCE5C\uC544\uBC84\uC9C0\uB97C
      \uB530\uB77C\uC11C \uB9C8\uACBD \uACF3\uACF3\uC744 \uB4E4\uC464\uC2DC\uACE0
      \uB2E4\uB154\uC9C0."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uBB3C\uB860 \uC9C0\uAE08\uC758 \uB9C8\uACBD\uC740 \uB0B4\uAC00 \uAE30\uC5B5\uD558\uB358
      \uACF3\uACFC\uB294 \uC644\uC804\uD788 \uB2E4\uB978 \uAC83 \uAC19\uC9C0\uB9CC.
      \uADF8\uB54C\uC758 \uB9C8\uACBD\uC740 \uADF8\uB0E5 \uC704\uD5D8\uD55C \uC57C\uC0DD\uB9BC
      \uC815\uB3C4\uC77C \uBFD0\uC774\uC5C8\uC5B4."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uC544\uBB34\uD2BC, \uADF8\uB7EC\uB2E4 \uC544\uBC84\uC9C0\uAED8\uC11C
      \uB3CC\uC544\uAC00\uC2DC\uC790 \uC591\uC544\uBC84\uC9C0\uAC00 \uB0A0 \uAC70\uB454
      \uAC70\uC57C."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uC4F8\uBAA8\uAC00 \uC788\uC5C8\uB358 \uAC70\uC9C0, \uB0B4\uAC00.
      \uC57C\uB9CC\uC778\uC758 \uB538\uC774\uACE0, \uB9C8\uACBD\uC744 \uD0D0\uD5D8\uD55C
      \uACBD\uD5D8\uB3C4 \uC788\uC5C8\uC73C\uB2C8\uAE4C."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uBD88\uB9CC\uC740 \uC5C6\uC5C8\uC5B4. \uADF8\uB7F0 \uC591\uC544\uBC84\uC9C0\uC758
      \uC2AC\uD558\uC5D0 \uC788\uC5C8\uAE30 \uB54C\uBB38\uC5D0 \uC801\uC5B4\uB3C4
      \uB09C \uC0B4\uC544\uB0A8\uC744 \uC218 \uC788\uC5C8\uC73C\uB2C8\uAE4C."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "......\uC788\uC796\uC544, \uC5D0\uBC14. \uB098\uB791 \uAC19\uC774
      \uB3C4\uB9DD\uCE58\uC9C0 \uC54A\uC744\uB798?"
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uBB50......?"
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uB10C \uC774\uB7EC\uB098\uC800\uB7EC\uB098 \uC8FD\uC740 \uBAA9\uC228\uC774\uB77C\uBA74\uC11C?
      \uC774\uC820 \uB098\uB3C4 \uC9C0\uCF1C\uC57C \uD560 \uC8FC\uBBFC\uC774 \uD55C
      \uBA85\uB3C4 \uB0A8\uC9C0 \uC54A\uAC8C \uB410\uC73C\uB2C8\uAE4C......."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uC5EC\uAE30\uC5D0\uC11C \uC6B0\uB9AC\uAC00 \uADF8\uB0E5 \uB3C4\uB9DD\uCE5C\uB2E4\uACE0
      \uD574\uB3C4 \uC544\uBB34\uB3C4 \uBB50\uB77C\uACE0 \uC548 \uD560 \uAC70\uC57C.
      \uADF8\uB7F4 \uC0AC\uB78C\uB3C4 \uC5C6\uC73C\uB2C8\uAE4C."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uADF8\uB9AC\uACE0 \uB124 \uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4\uBCF4\uB2C8\uAE4C,
      \uB124 \uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C\uB294 \uBCC4\uB85C \uC758\uB9AC\uB97C
      \uC9C0\uD0AC \uD544\uC694\uB3C4 \uC5C6\uC744 \uAC83 \uAC19\uC740\uAC78."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uADF8\uB7EC\uB2C8\uAE4C...... \uC751?"
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uC0AC\uC2E4 \uADF8\uB7F0 \uC0DD\uAC01\uC744 \uC548 \uD574\uBCF8 \uAC74
      \uC544\uB2C8\uC5C8\uB2E4."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uC544\uB2C8, \uC624\uD788\uB824 \uC218\uB3C4 \uC5C6\uC774 \uADF8\uB7F0
      \uC0DD\uAC01\uB9CC \uD588\uB2E4....... \uB0B4\uAC00 \uC65C \uC774\uB7F0 \uACE0\uD1B5\uC744
      \uACAA\uACE0 \uC788\uC5B4\uC57C \uD558\uB294\uAC00."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uB0B4\uAC00 \uC65C, \uB098\uB97C \uB3C4\uAD6C\uB85C \uC0AC\uC721\uD588\uC744
      \uBFD0\uC778 \uADF8 \uC0AC\uB78C\uC5D0\uAC8C \uCCA0\uC800\uD788 \uBCF5\uC885\uD558\uAE30\uB9CC
      \uD574\uC57C \uD558\uB294\uAC00......."
    nextType: 0
  - character: 0
    name: ' '
    sentence: "\uADF8\uB7EC\uB098, \uC774 \uBAA8\uB4E0 \uC0DD\uAC01\uC740 \uC5B8\uC81C\uB098
      \uD558\uB098\uC758 \uACB0\uB860\uC73C\uB85C \uC774\uC5B4\uC9C8 \uBFD0\uC774\uC5C8\uB2E4."
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uBBF8\uC548\uD558\uC9C0\uB9CC...... \uC548 \uB3FC."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uC65C?"
    nextType: 0
  - character: 1
    name: "\uC5D0\uBC14"
    sentence: "\uB9C8\uACBD\uC758 \uC2EC\uC7A5\uC73C\uB85C, \uAD6C\uD574\uC57C \uD560
      \uC0AC\uB78C\uC774 \uC788\uC73C\uB2C8\uAE4C."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "......\uADF8\uB807\uAD6C\uB098. \uC54C\uACA0\uC5B4."
    nextType: 0
  - character: 2
    name: "\uD50C\uB9B0\uB290"
    sentence: "\uC8FD\uC9C0 \uB9D0\uB77C\uACE0\uB294 \uC548 \uD560\uAC8C. \uADF8
      \uB300\uC2E0, \uAF2D \uC774\uACA8."
    nextType: 0
